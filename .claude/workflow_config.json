{
  "project_root": "..",
  "roadmap_file": "ROADMAP.md",
  "retrospective_file": "docs/RETROSPECTIVE.md",
  "ledger": {
    "enabled": true,
    "directory": "history"
  },
  "source_directories": ["hooks", "skills", "schemas", "templates"],
  "documentation_directories": ["docs"],
  "env_check": {
    "tool_paths": {
      "python": {
        "path": "python",
        "version_flag": "--version"
      }
    }
  },
  "loop_detection": {
    "enabled": true,
    "repeat_threshold": 3,
    "log_path": ".ai/08-behavioral-metrics/loop_detection.jsonl"
  },
  "tier0_guard": {
    "enabled": true,
    "protected_branches": [],
    "protected_paths": ["history", "plans/archive"],
    "escalate_history_rewrite": true,
    "escalate_heredoc": true
  },
  "governance": {
    "library_root": ".ai",
    "maturity_tracker": ".ai/00-system/maturity-tracker.json"
  },
  "stop_hook": {
    "max_blocks": 2,
    "main_branch_autodetect": true,
    "main_branch_remote": "origin",
    "main_branch_probe_remote": false
  },
  "workflow_update_check": {
    "enabled": false,
    "submodule_path": ".claude/workflow-core",
    "remote": "origin",
    "branch": "main"
  }
}
